{
  "manifest_version": 3,
  "name": "Hotmart Local Backup Bridge",
  "version": "1.0.0",
  "description": "Forwards Hotmart HLS manifests to a local backup process.",
  "permissions": ["webRequest"],
  "host_permissions": [
    "https://hotmart.com/*",
    "https://*.hotmart.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
